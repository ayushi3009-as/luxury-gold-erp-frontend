generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                   String                @id @default(uuid())
  name                 String
  subdomain            String                @unique
  customDomain         String?               @unique
  logoUrl              String?
  themeSettings        Json?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  aboutUsText          String?
  contactEmail         String?
  contactPhone         String?
  heroImageUrl         String?
  heroSubtitle         String?
  heroTitle            String?
  approvalStatus       TenantApprovalStatus  @default(PENDING)
  paymentReference     String?
  activityLogs         ActivityLog[]
  attendances          Attendance[]
  backupLogs           BackupLog[]
  branches             Branch[]
  branchEmployees      BranchEmployee[]
  branchTransfers      BranchTransfer[]
  categories           Category[]
  couponCodes          CouponCode[]
  customers            Customer[]
  customerLoyalties    CustomerLoyalty[]
  dashboardSettings    DashboardSetting[]
  deletedRecords       DeletedRecord[]
  departments          Department[]
  employees            Employee[]
  estimates            Estimate[]
  exchangeTransactions ExchangeTransaction[]
  financeAccounts      FinanceAccount[]
  financeExpenses      FinanceExpense[]
  financeIncomes       FinanceIncome[]
  financeReports       FinanceReport[]
  financeTransactions  FinanceTransaction[]
  grnitems             GRNItem[]
  goldRates            GoldRate[]
  goodsReceipts        GoodsReceipt[]
  holdBills            HoldBill[]
  idcards              IDCard[]
  incentives           Incentive[]
  inventories          Inventory[]
  invoices             Invoice[]
  invoiceItems         InvoiceItem[]
  leaves               Leave[]
  loginLogs            LoginLog[]
  loyaltyPrograms      LoyaltyProgram[]
  loyaltyTransactions  LoyaltyTransaction[]
  manufacturingOrders  ManufacturingOrder[]
  notifications        Notification[]
  offers               Offer[]
  offerBranches        OfferBranch[]
  offerCategories      OfferCategory[]
  offerProducts        OfferProduct[]
  offerRedemptions     OfferRedemption[]
  passwordResetTokens  PasswordResetToken[]
  payments             Payment[]
  payrolls             Payroll[]
  performances         Performance[]
  permissions          Permission[]
  products             Product[]
  productionLogs       ProductionLog[]
  purchaseInvoices     PurchaseInvoice[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  purchaseOrders       PurchaseOrder[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseReturns      PurchaseReturn[]
  purchaseReturnItems  PurchaseReturnItem[]
  repairOrders         RepairOrder[]
  roles                Role[]
  rolePermissions      RolePermission[]
  saaSClients          SaaSClient[]
  saaSInvoices         SaaSInvoice[]
  saaSPlans            SaaSPlan[]
  saaSSubscriptions    SaaSSubscription[]
  salaries             Salary[]
  salesReturns         SalesReturn[]
  securityLogs         SecurityLog[]
  stockEntries         StockEntry[]
  stockTransferItems   StockTransferItem[]
  storeSettings        StoreSettings[]
  suppliers            Supplier[]
  supplierPayments     SupplierPayment[]
  tasks                Task[]
  users                User[]
  userSessions         UserSession[]
  workOrders           WorkOrder[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenantId    String?
  tenant      Tenant?          @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(uuid())
  moduleName  String
  action      String
  description String?
  createdAt   DateTime         @default(now())
  tenantId    String?
  tenant      Tenant?          @relation(fields: [tenantId], references: [id])
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  tenantId     String?
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant       Tenant?    @relation(fields: [tenantId], references: [id])

  @@unique([roleId, permissionId])
}

model Branch {
  id                  String               @id @default(uuid())
  branchName          String
  branchCode          String               @unique
  branchType          BranchType
  address             String?
  city                String?
  state               String?
  country             String?
  pincode             String?
  phone               String?
  email               String?
  managerName         String?
  gstNumber           String?
  isHeadOffice        Boolean              @default(false)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tenantId            String?
  tenant              Tenant?              @relation(fields: [tenantId], references: [id])
  employees           BranchEmployee[]
  outgoingTransfers   BranchTransfer[]     @relation("FromBranch")
  incomingTransfers   BranchTransfer[]     @relation("ToBranch")
  financeAccounts     FinanceAccount[]
  financeExpenses     FinanceExpense[]
  financeIncomes      FinanceIncome[]
  financeReports      FinanceReport[]
  financeTransactions FinanceTransaction[]
  offerBranches       OfferBranch[]
  users               User[]
}

model User {
  id                  String               @id @default(uuid())
  roleId              String
  branchId            String?
  fullName            String
  username            String               @unique
  email               String               @unique
  mobile              String               @unique
  passwordHash        String
  profileImage        String?
  isActive            Boolean              @default(true)
  status              UserStatus           @default(ACTIVE)
  emailVerified       Boolean              @default(false)
  lastLogin           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tenantId            String?
  activityLogs        ActivityLog[]
  backupLogs          BackupLog[]
  branchEmployees     BranchEmployee[]
  approvedTransfers   BranchTransfer[]
  dashboard           DashboardSetting?
  deletedRecords      DeletedRecord[]
  employee            Employee?
  financeExpenses     FinanceExpense[]
  financeIncomes      FinanceIncome[]
  financeReports      FinanceReport[]
  financeTransactions FinanceTransaction[]
  loginLogs           LoginLog[]
  notifications       Notification[]
  createdOffers       Offer[]
  resetTokens         PasswordResetToken[]
  securityLogs        SecurityLog[]
  assignedTasks       Task[]
  branch              Branch?              @relation(fields: [branchId], references: [id])
  role                Role                 @relation(fields: [roleId], references: [id])
  tenant              Tenant?              @relation(fields: [tenantId], references: [id])
  sessions            UserSession[]
}

model DashboardSetting {
  id         String   @id @default(uuid())
  userId     String   @unique
  theme      String   @default("dark")
  language   String   @default("en")
  showCharts Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
}

model LoginLog {
  id              String      @id @default(uuid())
  userId          String
  loginTime       DateTime    @default(now())
  logoutTime      DateTime?
  ipAddress       String?
  device          String?
  browser         String?
  operatingSystem String?
  deviceName      String?
  status          LoginStatus
  createdAt       DateTime    @default(now())
  tenantId        String?
  tenant          Tenant?     @relation(fields: [tenantId], references: [id])
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id          String    @id @default(uuid())
  userId      String
  module      String
  action      LogAction
  description String
  ipAddress   String?
  createdAt   DateTime  @default(now())
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SecurityLog {
  id          String   @id @default(uuid())
  userId      String
  event       String
  severity    String
  ipAddress   String?
  description String?
  createdAt   DateTime @default(now())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeletedRecord {
  id        String   @id @default(uuid())
  userId    String
  module    String
  recordId  String
  reason    String?
  deletedAt DateTime @default(now())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BackupLog {
  id         String       @id @default(uuid())
  userId     String
  fileName   String
  backupDate DateTime     @default(now())
  status     BackupStatus
  remarks    String?
  createdAt  DateTime     @default(now())
  tenantId   String?
  tenant     Tenant?      @relation(fields: [tenantId], references: [id])
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Department {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenantId    String?
  tenant      Tenant?    @relation(fields: [tenantId], references: [id])
  employees   Employee[]
}

model Employee {
  id           String        @id @default(uuid())
  employeeCode String        @unique
  firstName    String
  lastName     String
  gender       String
  dateOfBirth  DateTime
  email        String        @unique
  phone        String
  address      String?
  designation  String
  joiningDate  DateTime
  basicSalary  Float
  userId       String        @unique
  departmentId String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenantId     String?
  attendance   Attendance[]
  department   Department    @relation(fields: [departmentId], references: [id])
  tenant       Tenant?       @relation(fields: [tenantId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  idCard       IDCard?
  incentives   Incentive[]
  leaves       Leave[]
  payrolls     Payroll[]
  performances Performance[]
}

model BranchEmployee {
  id            String    @id @default(uuid())
  userId        String
  branchId      String
  employeeCode  String    @unique
  designation   String
  department    String?
  joiningDate   DateTime
  relievingDate DateTime?
  salary        Decimal?  @db.Decimal(12, 2)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenantId      String?
  branch        Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Attendance {
  id         String    @id @default(uuid())
  employeeId String
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenantId   String?
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant     Tenant?   @relation(fields: [tenantId], references: [id])
}

model Leave {
  id         String   @id @default(uuid())
  employeeId String
  leaveType  String
  fromDate   DateTime
  toDate     DateTime
  reason     String?
  status     String
  approvedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenantId   String?
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
}

model Payroll {
  id          String   @id @default(uuid())
  employeeId  String
  month       Int
  year        Int
  basicSalary Float
  allowances  Float    @default(0)
  deductions  Float    @default(0)
  netSalary   Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String?
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  salary      Salary?
}

model Salary {
  id            String   @id @default(uuid())
  payrollId     String   @unique
  paymentDate   DateTime
  paymentMethod String
  transactionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenantId      String?
  payroll       Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])
}

model Performance {
  id         String   @id @default(uuid())
  employeeId String
  reviewDate DateTime
  rating     Int
  remarks    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenantId   String?
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
}

model Incentive {
  id          String   @id @default(uuid())
  employeeId  String
  title       String
  amount      Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String?
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
}

model IDCard {
  id         String    @id @default(uuid())
  employeeId String    @unique
  cardNumber String    @unique
  issueDate  DateTime
  expiryDate DateTime?
  qrCode     String?
  barcode    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenantId   String?
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant     Tenant?   @relation(fields: [tenantId], references: [id])
}

model Category {
  id              String          @id @default(uuid())
  name            String          @unique
  description     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  tenantId        String?
  tenant          Tenant?         @relation(fields: [tenantId], references: [id])
  offerCategories OfferCategory[]
}

model StockEntry {
  id                String    @id @default(uuid())
  entryNumber       String    @unique
  supplierName      String?
  entryDate         DateTime  @default(now())
  totalWeight       Float     @default(0)
  totalValue        Float     @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenantId          String?
  supplierInvoiceNo String?
  products          Product[]
  tenant            Tenant?   @relation(fields: [tenantId], references: [id])
}

model Product {
  id                  String               @id @default(uuid())
  productCode         String?              @unique
  barcode             String?              @unique
  name                String
  description         String?
  category            String?
  purity              String?
  weight              Float?
  goldRate            Float?
  makingCharge        Float?
  sellingPrice        Float?
  costPrice           Float?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tenantId            String?
  imageUrl            String?
  isPublished         Boolean              @default(false)
  stockEntryId        String?
  inventory           Inventory?
  invoiceItems        InvoiceItem[]
  manufacturingOrders ManufacturingOrder[]
  offerProducts       OfferProduct[]
  stockEntry          StockEntry?          @relation(fields: [stockEntryId], references: [id])
  tenant              Tenant?              @relation(fields: [tenantId], references: [id])
  purchaseItems       PurchaseOrderItem[]
  transferItems       StockTransferItem[]
  workOrders          WorkOrder[]
}

model Inventory {
  id           String        @id @default(uuid())
  productId    String        @unique
  quantity     Int
  minimumStock Int
  type         InventoryType
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenantId     String?
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant       Tenant?       @relation(fields: [tenantId], references: [id])
}

model BranchTransfer {
  id             String              @id @default(uuid())
  transferNumber String              @unique
  fromBranchId   String
  toBranchId     String
  approvedById   String?
  transferDate   DateTime            @default(now())
  receivedDate   DateTime?
  status         TransferStatus      @default(PENDING)
  remarks        String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  tenantId       String?
  approvedBy     User?               @relation(fields: [approvedById], references: [id])
  fromBranch     Branch              @relation("FromBranch", fields: [fromBranchId], references: [id])
  tenant         Tenant?             @relation(fields: [tenantId], references: [id])
  toBranch       Branch              @relation("ToBranch", fields: [toBranchId], references: [id])
  items          StockTransferItem[]
}

model StockTransferItem {
  id               String         @id @default(uuid())
  transferId       String
  productId        String
  quantity         Int
  receivedQuantity Int            @default(0)
  weight           Decimal?       @db.Decimal(12, 3)
  unitCost         Decimal?       @db.Decimal(12, 2)
  totalAmount      Decimal?       @db.Decimal(12, 2)
  remarks          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tenantId         String?
  product          Product        @relation(fields: [productId], references: [id])
  tenant           Tenant?        @relation(fields: [tenantId], references: [id])
  transfer         BranchTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@unique([transferId, productId])
}

model Customer {
  id                String            @id @default(uuid())
  name              String
  mobile            String            @unique
  email             String?
  address           String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  tenantId          String?
  tenant            Tenant?           @relation(fields: [tenantId], references: [id])
  customerLoyalties CustomerLoyalty[]
  estimates         Estimate[]
  holdBills         HoldBill[]
  invoices          Invoice[]
  offerRedemptions  OfferRedemption[]
}

model LoyaltyProgram {
  id                String            @id @default(uuid())
  programName       String
  description       String?
  pointsPerAmount   Decimal           @db.Decimal(10, 2)
  redeemValue       Decimal           @db.Decimal(10, 2)
  minimumPoints     Int
  expiryInMonths    Int?
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  tenantId          String?
  customerLoyalties CustomerLoyalty[]
  tenant            Tenant?           @relation(fields: [tenantId], references: [id])
}

model CustomerLoyalty {
  id              String               @id @default(uuid())
  customerId      String
  programId       String
  membershipNo    String               @unique
  totalPoints     Int                  @default(0)
  earnedPoints    Int                  @default(0)
  redeemedPoints  Int                  @default(0)
  expiredPoints   Int                  @default(0)
  availablePoints Int                  @default(0)
  membershipDate  DateTime             @default(now())
  expiryDate      DateTime?
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  tenantId        String?
  customer        Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  program         LoyaltyProgram       @relation(fields: [programId], references: [id])
  tenant          Tenant?              @relation(fields: [tenantId], references: [id])
  transactions    LoyaltyTransaction[]

  @@unique([customerId, programId])
}

model LoyaltyTransaction {
  id                String                 @id @default(uuid())
  customerLoyaltyId String
  invoiceId         String?
  transactionType   LoyaltyTransactionType
  points            Int
  balanceAfter      Int
  remarks           String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  tenantId          String?
  customerLoyalty   CustomerLoyalty        @relation(fields: [customerLoyaltyId], references: [id], onDelete: Cascade)
  invoice           Invoice?               @relation(fields: [invoiceId], references: [id])
  tenant            Tenant?                @relation(fields: [tenantId], references: [id])
}

model Offer {
  id              String            @id @default(uuid())
  offerName       String
  offerCode       String            @unique
  description     String?
  offerType       OfferType
  discountType    DiscountType
  discountValue   Decimal           @db.Decimal(12, 2)
  minimumPurchase Decimal?          @db.Decimal(12, 2)
  maximumDiscount Decimal?          @db.Decimal(12, 2)
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean           @default(true)
  createdById     String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tenantId        String?
  coupons         CouponCode[]
  createdBy       User              @relation(fields: [createdById], references: [id])
  tenant          Tenant?           @relation(fields: [tenantId], references: [id])
  branches        OfferBranch[]
  categories      OfferCategory[]
  products        OfferProduct[]
  redemptions     OfferRedemption[]
}

model OfferProduct {
  id        String   @id @default(uuid())
  offerId   String
  productId String
  createdAt DateTime @default(now())
  tenantId  String?
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])

  @@unique([offerId, productId])
}

model OfferCategory {
  id         String   @id @default(uuid())
  offerId    String
  categoryId String
  createdAt  DateTime @default(now())
  tenantId   String?
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  offer      Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])

  @@unique([offerId, categoryId])
}

model OfferBranch {
  id        String   @id @default(uuid())
  offerId   String
  branchId  String
  createdAt DateTime @default(now())
  tenantId  String?
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])

  @@unique([offerId, branchId])
}

model CouponCode {
  id              String            @id @default(uuid())
  offerId         String
  couponCode      String            @unique
  description     String?
  usageLimit      Int               @default(1)
  usedCount       Int               @default(0)
  minimumPurchase Decimal?          @db.Decimal(12, 2)
  maximumDiscount Decimal?          @db.Decimal(12, 2)
  validFrom       DateTime
  validTo         DateTime
  status          CouponStatus      @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tenantId        String?
  offer           Offer             @relation(fields: [offerId], references: [id], onDelete: Cascade)
  tenant          Tenant?           @relation(fields: [tenantId], references: [id])
  redemptions     OfferRedemption[]
}

model OfferRedemption {
  id             String      @id @default(uuid())
  offerId        String
  customerId     String
  invoiceId      String?
  couponId       String?
  discountAmount Decimal     @db.Decimal(12, 2)
  redeemedAt     DateTime    @default(now())
  remarks        String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tenantId       String?
  coupon         CouponCode? @relation(fields: [couponId], references: [id])
  customer       Customer    @relation(fields: [customerId], references: [id])
  invoice        Invoice?    @relation(fields: [invoiceId], references: [id])
  offer          Offer       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  tenant         Tenant?     @relation(fields: [tenantId], references: [id])
}

model Invoice {
  id                   String                @id @default(uuid())
  invoiceNo            String                @unique
  customerId           String
  totalAmount          Float
  status               String                @default("PENDING")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  discountTotal        Float                 @default(0)
  subTotal             Float                 @default(0)
  taxTotal             Float                 @default(0)
  tenantId             String?
  exchangeTransactions ExchangeTransaction[]
  customer             Customer              @relation(fields: [customerId], references: [id])
  tenant               Tenant?               @relation(fields: [tenantId], references: [id])
  items                InvoiceItem[]
  loyaltyTransactions  LoyaltyTransaction[]
  offerRedemptions     OfferRedemption[]
  payments             Payment[]
  salesReturns         SalesReturn[]
}

model InvoiceItem {
  id           String  @id @default(uuid())
  invoiceId    String
  productId    String
  quantity     Int     @default(1)
  weight       Float?
  amount       Float
  makingCharge Float   @default(0)
  metalRate    Float   @default(0)
  taxPercent   Float   @default(0)
  unitPrice    Float   @default(0)
  tenantId     String?
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id])
  tenant       Tenant? @relation(fields: [tenantId], references: [id])
}

model Payment {
  id            String   @id @default(uuid())
  invoiceId     String
  paymentMode   String
  amount        Float
  transactionId String?
  createdAt     DateTime @default(now())
  tenantId      String?
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])
}

model Estimate {
  id          String   @id @default(uuid())
  estimateNo  String   @unique
  customerId  String
  totalAmount Float
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  tenantId    String?
  customer    Customer @relation(fields: [customerId], references: [id])
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
}

model HoldBill {
  id          String    @id @default(uuid())
  holdNo      String    @unique
  customerId  String?
  totalAmount Float
  status      String    @default("HOLD")
  createdAt   DateTime  @default(now())
  tenantId    String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model SalesReturn {
  id           String   @id @default(uuid())
  invoiceId    String
  returnAmount Float
  reason       String?
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  tenantId     String?
  invoice      Invoice  @relation(fields: [invoiceId], references: [id])
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
}

model ExchangeTransaction {
  id               String   @id @default(uuid())
  invoiceId        String
  oldGoldWeight    Float
  oldGoldValue     Float
  newProductValue  Float
  differenceAmount Float
  createdAt        DateTime @default(now())
  tenantId         String?
  invoice          Invoice  @relation(fields: [invoiceId], references: [id])
  tenant           Tenant?  @relation(fields: [tenantId], references: [id])
}

model ManufacturingOrder {
  id          String           @id @default(uuid())
  orderNumber String           @unique
  productId   String
  quantity    Int
  startDate   DateTime
  endDate     DateTime?
  status      ProductionStatus
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenantId    String?
  product     Product          @relation(fields: [productId], references: [id])
  tenant      Tenant?          @relation(fields: [tenantId], references: [id])
  workOrders  WorkOrder[]
}

model WorkOrder {
  id              String             @id @default(uuid())
  manufacturingId String
  productId       String
  operationName   String
  assignedTo      String?
  status          ProductionStatus
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  tenantId        String?
  productionLogs  ProductionLog[]
  manufacturing   ManufacturingOrder @relation(fields: [manufacturingId], references: [id], onDelete: Cascade)
  product         Product            @relation(fields: [productId], references: [id])
  tenant          Tenant?            @relation(fields: [tenantId], references: [id])
}

model ProductionLog {
  id           String    @id @default(uuid())
  workOrderId  String
  completedQty Int
  remarks      String?
  createdAt    DateTime  @default(now())
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

model FinanceAccount {
  id             String               @id @default(uuid())
  branchId       String
  accountName    String
  accountNumber  String?
  accountType    String
  bankName       String?
  ifscCode       String?
  openingBalance Decimal              @db.Decimal(18, 2)
  currentBalance Decimal              @db.Decimal(18, 2)
  status         Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  tenantId       String?
  branch         Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tenant         Tenant?              @relation(fields: [tenantId], references: [id])
  expenses       FinanceExpense[]
  incomes        FinanceIncome[]
  transactions   FinanceTransaction[]
}

model FinanceIncome {
  id            String         @id @default(uuid())
  branchId      String
  accountId     String
  createdById   String
  incomeDate    DateTime
  incomeSource  String
  referenceNo   String?
  paymentMethod String
  amount        Decimal        @db.Decimal(18, 2)
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenantId      String?
  account       FinanceAccount @relation(fields: [accountId], references: [id])
  branch        Branch         @relation(fields: [branchId], references: [id])
  createdBy     User           @relation(fields: [createdById], references: [id])
  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
}

model FinanceExpense {
  id            String         @id @default(uuid())
  branchId      String
  accountId     String
  createdById   String
  expenseDate   DateTime
  category      String
  vendorName    String?
  billNumber    String?
  paymentMethod String
  amount        Decimal        @db.Decimal(18, 2)
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenantId      String?
  account       FinanceAccount @relation(fields: [accountId], references: [id])
  branch        Branch         @relation(fields: [branchId], references: [id])
  createdBy     User           @relation(fields: [createdById], references: [id])
  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
}

model FinanceTransaction {
  id              String         @id @default(uuid())
  branchId        String
  accountId       String
  transactionType String
  referenceType   String?
  referenceId     String?
  transactionDate DateTime
  paymentMethod   String
  amount          Decimal        @db.Decimal(18, 2)
  remarks         String?
  createdById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tenantId        String?
  account         FinanceAccount @relation(fields: [accountId], references: [id])
  branch          Branch         @relation(fields: [branchId], references: [id])
  createdBy       User           @relation(fields: [createdById], references: [id])
  tenant          Tenant?        @relation(fields: [tenantId], references: [id])
}

model FinanceReport {
  id            String   @id @default(uuid())
  branchId      String
  generatedById String
  reportName    String
  reportType    String
  fromDate      DateTime
  toDate        DateTime
  totalIncome   Decimal  @db.Decimal(18, 2)
  totalExpense  Decimal  @db.Decimal(18, 2)
  totalSales    Decimal  @db.Decimal(18, 2)
  netProfit     Decimal  @db.Decimal(18, 2)
  filePath      String?
  createdAt     DateTime @default(now())
  tenantId      String?
  branch        Branch   @relation(fields: [branchId], references: [id])
  generatedBy   User     @relation(fields: [generatedById], references: [id])
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])
}

model Supplier {
  id             String            @id @default(uuid())
  supplierCode   String            @unique
  supplierName   String
  contactNumber  String?
  email          String?
  gstNumber      String?
  address        String?
  city           String?
  state          String?
  country        String?           @default("India")
  status         String            @default("ACTIVE")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  tenantId       String?
  goodsReceipts  GoodsReceipt[]
  invoices       PurchaseInvoice[]
  purchaseOrders PurchaseOrder[]
  returns        PurchaseReturn[]
  tenant         Tenant?           @relation(fields: [tenantId], references: [id])
  payments       SupplierPayment[]
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  poNumber      String              @unique
  supplierId    String
  orderDate     DateTime            @default(now())
  expectedDate  DateTime?
  status        String              @default("PENDING")
  subtotal      Float               @default(0)
  gstAmount     Float               @default(0)
  totalAmount   Float               @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  tenantId      String?
  goodsReceipts GoodsReceipt[]
  invoices      PurchaseInvoice[]
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  tenant        Tenant?             @relation(fields: [tenantId], references: [id])
  items         PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  category        String
  itemName        String
  purity          String?
  quantity        Int           @default(1)
  weight          Float
  goldRate        Float?
  makingCharge    Float?
  wastagePercent  Float?
  itemTotal       Float
  productId       String?
  createdAt       DateTime      @default(now())
  tenantId        String?
  product         Product?      @relation(fields: [productId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  tenant          Tenant?       @relation(fields: [tenantId], references: [id])
}

model GoodsReceipt {
  id              String        @id @default(uuid())
  grnNumber       String        @unique
  purchaseOrderId String
  supplierId      String
  receiptDate     DateTime      @default(now())
  qualityStatus   String        @default("PENDING")
  receiptStatus   String        @default("PENDING")
  totalWeight     Float         @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenantId        String?
  items           GRNItem[]
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  supplier        Supplier      @relation(fields: [supplierId], references: [id])
  tenant          Tenant?       @relation(fields: [tenantId], references: [id])
}

model GRNItem {
  id               String       @id @default(uuid())
  grnId            String
  itemName         String
  category         String
  purity           String?
  orderedWeight    Float
  receivedWeight   Float
  differenceWeight Float
  qualityResult    String
  createdAt        DateTime     @default(now())
  tenantId         String?
  grn              GoodsReceipt @relation(fields: [grnId], references: [id], onDelete: Cascade)
  tenant           Tenant?      @relation(fields: [tenantId], references: [id])
}

model PurchaseInvoice {
  id              String                @id @default(uuid())
  invoiceNumber   String                @unique
  supplierId      String
  purchaseOrderId String?
  invoiceDate     DateTime              @default(now())
  subtotal        Float                 @default(0)
  gstAmount       Float                 @default(0)
  totalAmount     Float                 @default(0)
  paymentStatus   String                @default("PENDING")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  tenantId        String?
  purchaseOrder   PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  supplier        Supplier              @relation(fields: [supplierId], references: [id])
  tenant          Tenant?               @relation(fields: [tenantId], references: [id])
  items           PurchaseInvoiceItem[]
  returns         PurchaseReturn[]
  payments        SupplierPayment[]
}

model PurchaseInvoiceItem {
  id            String          @id @default(uuid())
  invoiceId     String
  itemName      String
  category      String
  purity        String?
  weight        Float
  rate          Float
  gstPercentage Float
  amount        Float
  createdAt     DateTime        @default(now())
  tenantId      String?
  invoice       PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant        Tenant?         @relation(fields: [tenantId], references: [id])
}

model SupplierPayment {
  id              String           @id @default(uuid())
  supplierId      String
  invoiceId       String?
  paymentDate     DateTime         @default(now())
  paymentMode     String
  amount          Float
  referenceNumber String?
  status          String           @default("COMPLETED")
  createdAt       DateTime         @default(now())
  tenantId        String?
  invoice         PurchaseInvoice? @relation(fields: [invoiceId], references: [id])
  supplier        Supplier         @relation(fields: [supplierId], references: [id])
  tenant          Tenant?          @relation(fields: [tenantId], references: [id])
}

model PurchaseReturn {
  id           String               @id @default(uuid())
  returnNumber String               @unique
  invoiceId    String
  supplierId   String
  returnDate   DateTime             @default(now())
  reason       String?
  totalAmount  Float                @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  tenantId     String?
  invoice      PurchaseInvoice      @relation(fields: [invoiceId], references: [id])
  supplier     Supplier             @relation(fields: [supplierId], references: [id])
  tenant       Tenant?              @relation(fields: [tenantId], references: [id])
  items        PurchaseReturnItem[]
}

model PurchaseReturnItem {
  id             String         @id @default(uuid())
  returnId       String
  itemName       String
  weight         Float
  quantity       Int
  amount         Float
  createdAt      DateTime       @default(now())
  tenantId       String?
  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  tenant         Tenant?        @relation(fields: [tenantId], references: [id])
}

model GoldRate {
  id          String   @id @default(uuid())
  gold24k     Float
  gold22k     Float
  gold18k     Float
  silver      Float
  platinum    Float
  effectiveAt DateTime @default(now())
  createdAt   DateTime @default(now())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
}

model SaaSClient {
  id            String             @id @default(uuid())
  name          String
  email         String             @unique
  phone         String?
  domain        String             @unique
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  tenantId      String?
  tenant        Tenant?            @relation(fields: [tenantId], references: [id])
  subscriptions SaaSSubscription[]
}

model SaaSPlan {
  id            String             @id @default(uuid())
  name          String             @unique
  description   String?
  pricePerMonth Float
  pricePerYear  Float
  maxUsers      Int                @default(5)
  maxBranches   Int                @default(1)
  features      String?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  tenantId      String?
  tenant        Tenant?            @relation(fields: [tenantId], references: [id])
  subscriptions SaaSSubscription[]
}

model SaaSSubscription {
  id           String        @id @default(uuid())
  clientId     String
  planId       String
  status       String        @default("ACTIVE")
  startDate    DateTime      @default(now())
  endDate      DateTime
  billingCycle String        @default("MONTHLY")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenantId     String?
  invoices     SaaSInvoice[]
  client       SaaSClient    @relation(fields: [clientId], references: [id])
  plan         SaaSPlan      @relation(fields: [planId], references: [id])
  tenant       Tenant?       @relation(fields: [tenantId], references: [id])
}

model SaaSInvoice {
  id             String           @id @default(uuid())
  subscriptionId String
  invoiceNumber  String           @unique
  amount         Float
  status         String           @default("PAID")
  paymentDate    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenantId       String?
  subscription   SaaSSubscription @relation(fields: [subscriptionId], references: [id])
  tenant         Tenant?          @relation(fields: [tenantId], references: [id])
}

model StoreSettings {
  id           String   @id @default(uuid())
  storeName    String   @default("Luxury Gold")
  brandColor   String   @default("#e4b52d")
  heroImageUrl String?
  logoUrl      String?
  tagline      String?
  contactEmail String?
  contactPhone String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
}

model RepairOrder {
  id             String    @id @default(uuid())
  repairNumber   String    @unique
  customerName   String
  customerPhone  String
  itemName       String
  description    String?
  estimatedCost  Float?
  advancePaid    Float     @default(0)
  status         String    @default("PENDING")
  expectedDate   DateTime?
  workerAssigned String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenantId       String?
  tenant         Tenant?   @relation(fields: [tenantId], references: [id])
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  assigneeId  String?
  dueDate     DateTime?
  priority    String    @default("Medium")
  status      String    @default("Pending")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenantId    String?
  assignee    User?     @relation(fields: [assigneeId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum BranchType {
  HEAD_OFFICE
  MAIN_BRANCH
  SUB_BRANCH
  FRANCHISE
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  DOWNLOAD
  VIEW
}

enum LoginStatus {
  SUCCESS
  FAILED
}

enum BackupStatus {
  SUCCESS
  FAILED
  RUNNING
}

enum ProductionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InventoryType {
  RAW_MATERIAL
  FINISHED_GOOD
}

enum OfferType {
  FLAT
  PERCENTAGE
  BUY_GET
  COUPON
  MAKING_CHARGE
  GOLD_RATE
}

enum DiscountType {
  AMOUNT
  PERCENTAGE
}

enum CouponStatus {
  ACTIVE
  EXPIRED
  DISABLED
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  EXPIRE
  ADJUSTMENT
}

enum TransferStatus {
  PENDING
  APPROVED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum TenantApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
